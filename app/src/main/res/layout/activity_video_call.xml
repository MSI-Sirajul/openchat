<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_video_call"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A"
    android:keepScreenOn="true">

    <!-- 1. Full-screen Remote Video View -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Remote Video Placeholder (Shown when remote video is not playing or camera paused) -->
    <LinearLayout
        android:id="@+id/layout_remote_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <ImageView
                android:id="@+id/img_remote_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Contact Avatar"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/text_remote_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="J" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_placeholder_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_video_pill_status"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            tools:text="Camera is off" />
    </LinearLayout>

    <!-- 2. Draggable Local Self-View Preview Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_local_preview"
        android:layout_width="110dp"
        android:layout_height="160dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="110dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/local_video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Local camera off placeholder -->
            <LinearLayout
                android:id="@+id/layout_local_camera_off"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80000000"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Camera Off"
                    android:src="@drawable/ic_videocam_off_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Camera Off"
                    android:textColor="#CCCCCC"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Top Bar Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#4D000000"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Minimize / PiP Button -->
        <ImageButton
            android:id="@+id/btn_minimize"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Minimize"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pip_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <!-- Peer Info (Avatar + Name) -->
        <LinearLayout
            android:id="@+id/layout_peer_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_timer_pill"
            app:layout_constraintStart_toEndOf="@id/btn_minimize"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/text_peer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Jane Doe" />
        </LinearLayout>

        <!-- Duration Timer & Network Status Pill -->
        <LinearLayout
            android:id="@+id/layout_timer_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_video_pill_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/view_network_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_online_dot" />

            <TextView
                android:id="@+id/text_call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="02:45" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. Reconnecting / Poor Connection Banner -->
    <TextView
        android:id="@+id/text_reconnecting_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:gravity="center"
        android:padding="8dp"
        android:text="Reconnecting call..."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar" />

    <!-- 5. Bottom Controls Overlay (Connected State) -->
    <LinearLayout
        android:id="@+id/layout_bottom_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#4D000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Mute Audio Toggle -->
        <ImageButton
            android:id="@+id/btn_mute"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_video_call_control_circle"
            android:contentDescription="Mute Audio"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic_24"
            app:tint="#FFFFFF" />

        <!-- Camera On/Off Toggle -->
        <ImageButton
            android:id="@+id/btn_camera_toggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_video_call_control_circle"
            android:contentDescription="Toggle Camera"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_camera_24"
            app:tint="#FFFFFF" />

        <!-- Switch Camera (Front/Back) -->
        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_video_call_control_circle"
            android:contentDescription="Switch Camera"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_cameraswitch_24"
            app:tint="#FFFFFF" />

        <!-- Speakerphone Toggle -->
        <ImageButton
            android:id="@+id/btn_speaker"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_video_call_control_circle"
            android:contentDescription="Speakerphone"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_volume_up_24"
            app:tint="#FFFFFF" />

        <!-- End Call FAB (Red) -->
        <ImageButton
            android:id="@+id/btn_end_call"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_video_call_end_circle"
            android:contentDescription="End Video Call"
            android:elevation="6dp"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_call_end_24"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 6. Outgoing Calling Overlay (Calling / Ringing state before answer) -->
    <LinearLayout
        android:id="@+id/layout_outgoing_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC0A0E1A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="130dp">

            <ImageView
                android:id="@+id/img_outgoing_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Outgoing Avatar"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/text_outgoing_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="50sp"
                android:textStyle="bold"
                tools:text="D" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_outgoing_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Jane Doe" />

        <TextView
            android:id="@+id/text_outgoing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calling..."
            android:textColor="#B0BEC5"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_cancel_outgoing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_video_call_end_circle"
            android:contentDescription="Cancel Call"
            android:elevation="6dp"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_call_end_24"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 7. Incoming Video Call Overlay (Ringing State) -->
    <LinearLayout
        android:id="@+id/layout_incoming_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E60A0E1A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/img_incoming_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Incoming Caller Avatar"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/text_incoming_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="54sp"
                android:textStyle="bold"
                tools:text="J" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_incoming_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Jane Doe" />

        <TextView
            android:id="@+id/text_incoming_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Incoming Video Call..."
            android:textColor="#80D8FF"
            android:textSize="16sp" />

        <!-- Accept & Decline Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Decline Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_decline_incoming"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_video_call_end_circle"
                    android:contentDescription="Decline Call"
                    android:elevation="6dp"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_end_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Decline"
                    android:textColor="#FF8A80"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Accept Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_accept_incoming"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_online_dot"
                    android:contentDescription="Accept Video Call"
                    android:elevation="6dp"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_video_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Accept"
                    android:textColor="#B9F6CA"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
