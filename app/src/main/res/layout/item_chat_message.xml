<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Floating Date Separator Capsule -->
    <TextView
        android:id="@+id/textDateSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_date_capsule"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/color_date_capsule_text"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Yesterday" />

    <!-- Message Bubble Container Row -->
    <LinearLayout
        android:id="@+id/layoutBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_outgoing"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- Media Container (Image or Video) -->
        <FrameLayout
            android:id="@+id/layoutMediaContainer"
            android:layout_width="240dp"
            android:layout_height="180dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_media_rounded"
            android:clipToOutline="true"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/imageAttachment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Attached photo" />

            <!-- Video Overlay with Play Button & Scrim -->
            <FrameLayout
                android:id="@+id/layoutVideoOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_media_scrim"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iconPlayVideo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_media_scrim_overlay"
                    android:padding="12dp"
                    android:src="@drawable/ic_play_24"
                    app:tint="@color/white"
                    android:contentDescription="Play video" />

                <TextView
                    android:id="@+id/textVideoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_date_capsule"
                    android:backgroundTint="@color/color_media_scrim_overlay"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="VIDEO"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <!-- Voice Note Player Row -->
        <LinearLayout
            android:id="@+id/layoutVoiceNote"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btnPlayVoice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play_24"
                android:contentDescription="Play voice note" />

            <ProgressBar
                android:id="@+id/progressVoice"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/color_voice_seek_active"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/textVoiceDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/color_bubble_outgoing_text"
                tools:text="0:15" />
        </LinearLayout>

        <!-- Document / File Row -->
        <LinearLayout
            android:id="@+id/layoutFileAttachment"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_file_24"
                app:tint="@color/color_primary"
                android:contentDescription="File icon" />

            <TextView
                android:id="@+id/textFileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textSize="13sp"
                android:textColor="@color/color_bubble_outgoing_text"
                tools:text="Project_Report.pdf" />
        </LinearLayout>

        <!-- Text Message Body -->
        <TextView
            android:id="@+id/textMessageBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/color_bubble_outgoing_text"
            tools:text="Hey, checking in on the performance updates!" />

        <!-- Timestamp and Status Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/color_timestamp_outgoing"
                tools:text="14:32" />

            <TextView
                android:id="@+id/textSeenStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/color_status_online"
                android:text="Seen"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/imageMessageStatus"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Message status"
                android:visibility="gone"
                tools:visibility="visible"
                tools:src="@drawable/ic_read" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
