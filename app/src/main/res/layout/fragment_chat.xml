<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_chat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Chat Header Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_chat"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_surface"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:elevation="2dp">

            <LinearLayout
                android:id="@+id/layout_contact_header"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Contact Avatar -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <TextView
                        android:id="@+id/text_chat_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_circle"
                        android:backgroundTint="@color/color_avatar_bg"
                        android:gravity="center"
                        android:text="U"
                        android:textColor="@color/color_avatar_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/img_chat_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/dot_chat_online"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_online_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Name & Online Status -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_chat_contact_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contact"
                        android:textColor="@color/color_primary_text"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/text_chat_contact_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline"
                        android:textColor="@color/color_secondary_text"
                        android:textSize="12sp"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Call Action Button -->
            <ImageButton
                android:id="@+id/btn_chat_call"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_call_24"
                android:contentDescription="Call"
                app:tint="@color/color_primary" />

            <!-- Overflow Menu Button -->
            <ImageButton
                android:id="@+id/btn_chat_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert_24"
                android:contentDescription="More Options"
                app:tint="@color/color_primary_text" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Media Upload Progress Bar -->
        <LinearLayout
            android:id="@+id/layout_upload_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/color_surface_variant"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_uploading_media"
                android:textColor="@color/color_primary"
                android:textSize="12sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:indeterminate="true"
                app:indicatorColor="@color/color_primary" />
        </LinearLayout>

        <!-- Messages Native RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:overScrollMode="ifContentScrolls" />

        <!-- Realtime Animated Typing Indicator Bubble -->
        <LinearLayout
            android:id="@+id/layout_typing_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_bubble_incoming"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- 3 Animated Bouncing Dots -->
            <LinearLayout
                android:id="@+id/layout_typing_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">

                <View
                    android:id="@+id/dot_typing_1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_primary" />

                <View
                    android:id="@+id/dot_typing_2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_primary" />

                <View
                    android:id="@+id/dot_typing_3"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_typing_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="typing..."
                android:textColor="@color/color_secondary_text"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Audio Recording Overlay Bar (visible during voice recording) -->
        <LinearLayout
            android:id="@+id/layout_recording_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/color_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_cancel_recording"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:contentDescription="Cancel Recording"
                app:tint="@color/color_error" />

            <View
                android:id="@+id/dot_recording_blink"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/color_error" />

            <TextView
                android:id="@+id/text_recording_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Recording 0:00"
                android:textColor="@color/color_error"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_recording"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Send"
                android:textSize="13sp"
                app:icon="@drawable/ic_send_24"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/color_primary" />
        </LinearLayout>

        <!-- Message Input Bar -->
        <LinearLayout
            android:id="@+id/layout_input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <!-- Attachment Button -->
            <ImageButton
                android:id="@+id/btn_chat_attach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_attach_file_24"
                android:contentDescription="Attach File"
                app:tint="@color/color_secondary_text" />

            <!-- Text Message Input -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_bubble_incoming"
                android:backgroundTint="@color/color_surface_variant"
                android:hint="@string/chat_type_message_hint"
                android:textColorHint="@color/color_secondary_text"
                android:textColor="@color/color_primary_text"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:maxLines="5"
                android:minHeight="44dp" />

            <!-- Send / Voice Record Button -->
            <ImageButton
                android:id="@+id/btn_chat_send_or_mic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mic_24"
                android:contentDescription="Send or Record"
                app:tint="@color/color_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fullscreen Media Preview Overlay (Photo / Video Viewer) -->
    <FrameLayout
        android:id="@+id/layout_fullscreen_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <!-- Top Preview Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="12dp"
            android:background="#A0000000">

            <ImageButton
                android:id="@+id/btn_close_preview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:contentDescription="Close Preview"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/text_preview_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:text="Media Preview" />

            <!-- Download Button: saves file to OpenChat/ subfolders on device -->
            <ImageButton
                android:id="@+id/btn_download_preview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_download_24"
                android:contentDescription="Download to OpenChat folder"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Loading spinner for media download / resolution -->
        <ProgressBar
            android:id="@+id/progress_preview_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Error display if file could not be retrieved -->
        <TextView
            android:id="@+id/text_preview_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Photo ImageView -->
        <ImageView
            android:id="@+id/img_preview_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Video Player VideoView -->
        <VideoView
            android:id="@+id/video_preview_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
