<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_chat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_wallpaper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Chat Header Toolbar (Edge-to-edge safe, flat 0dp elevation) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_chat"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/color_toolbar_background"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="@color/color_toolbar_icon"
            app:navigationContentDescription="Back"
            app:elevation="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:contentInsetEnd="0dp">

            <!-- Master horizontal container inside Toolbar for reliable weight measurement -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Contact Header (Avatar + Name + Status) -->
                <LinearLayout
                    android:id="@+id/layout_contact_header"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="2dp"
                    android:paddingEnd="4dp">

                    <!-- Contact Avatar Frame (40dp x 40dp) -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical">

                        <TextView
                            android:id="@+id/text_chat_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar_circle"
                            android:backgroundTint="@color/color_avatar_bg"
                            android:gravity="center"
                            android:text="U"
                            android:textColor="@color/color_avatar_text"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"
                            android:visibility="gone" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/img_chat_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_default_avatar"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            android:visibility="visible" />

                        <View
                            android:id="@+id/dot_chat_online"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_online_dot"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Name & Online / Last Seen Status -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_chat_contact_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Contact"
                            android:textColor="@color/color_toolbar_title"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"
                            android:lineHeight="20sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/text_chat_contact_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Offline"
                            android:textColor="@color/color_toolbar_subtitle"
                            android:textSize="12.5sp"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Actions: Video Call, Voice Call, Overflow Menu -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="4dp">

                    <!-- Video Call Action Button (44dp) -->
                    <ImageButton
                        android:id="@+id/btn_chat_video_call"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_video_24"
                        android:contentDescription="Video Call"
                        app:tint="@color/color_toolbar_icon" />

                    <!-- Voice Call Action Button (44dp) -->
                    <ImageButton
                        android:id="@+id/btn_chat_call"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_call_24"
                        android:contentDescription="Voice Call"
                        app:tint="@color/color_toolbar_icon" />

                    <!-- Overflow Menu Button (44dp) -->
                    <ImageButton
                        android:id="@+id/btn_chat_more"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_more_vert_24"
                        android:contentDescription="More Options"
                        app:tint="@color/color_toolbar_icon" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Razor-thin subtle divider below toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider" />

        <!-- Media Upload Progress Bar -->
        <LinearLayout
            android:id="@+id/layout_upload_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/color_surface_variant"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_uploading_media"
                android:textColor="@color/color_primary"
                android:textSize="12sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:indeterminate="true"
                app:indicatorColor="@color/color_primary" />
        </LinearLayout>

        <!-- Messages Native RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:overScrollMode="ifContentScrolls" />

        <!-- Realtime Animated Typing Indicator Bubble -->
        <LinearLayout
            android:id="@+id/layout_typing_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_bubble_incoming"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- 3 Animated Bouncing Dots -->
            <LinearLayout
                android:id="@+id/layout_typing_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">

                <View
                    android:id="@+id/dot_typing_1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_primary" />

                <View
                    android:id="@+id/dot_typing_2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_primary" />

                <View
                    android:id="@+id/dot_typing_3"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_typing_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="typing..."
                android:textColor="@color/color_secondary_text"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Audio Recording Overlay Bar (visible during voice recording) -->
        <LinearLayout
            android:id="@+id/layout_recording_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/color_composer_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_cancel_recording"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:contentDescription="Cancel Recording"
                app:tint="@color/color_error" />

            <View
                android:id="@+id/dot_recording_blink"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/color_error" />

            <TextView
                android:id="@+id/text_recording_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Recording 0:00"
                android:textColor="@color/color_error"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_recording"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Send"
                android:textSize="13sp"
                app:icon="@drawable/ic_send_24"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/color_composer_action_bg"
                app:iconTint="@color/color_composer_action_icon" />
        </LinearLayout>

        <!-- Subtle Top Divider above composer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider" />

        <!-- Message Composer Input Bar -->
        <LinearLayout
            android:id="@+id/layout_input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_composer_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Attachment Button (48dp touch target) -->
            <ImageButton
                android:id="@+id/btn_chat_attach"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_attach_file_24"
                android:contentDescription="Attach File"
                app:tint="@color/color_composer_icon" />

            <!-- Rounded Pill Text Message Input -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_composer_input"
                android:hint="@string/chat_type_message_hint"
                android:textColorHint="@color/color_composer_hint"
                android:textColor="@color/color_composer_text"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:maxLines="5"
                android:minHeight="44dp" />

            <!-- Send / Voice Record Action Floating Pill Button -->
            <ImageButton
                android:id="@+id/btn_chat_send_or_mic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_composer_action_btn"
                android:src="@drawable/ic_mic_24"
                android:contentDescription="Send or Record"
                app:tint="@color/color_composer_action_icon" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fullscreen Media Preview Overlay (Photo / Video Viewer) -->
    <FrameLayout
        android:id="@+id/layout_fullscreen_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <!-- Top Preview Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="12dp"
            android:background="#A0000000">

            <ImageButton
                android:id="@+id/btn_close_preview"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:contentDescription="Close Preview"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/text_preview_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:text="Media Preview" />

            <!-- Download Button -->
            <ImageButton
                android:id="@+id/btn_download_preview"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_download_24"
                android:contentDescription="Download to OpenChat folder"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Loading spinner for media download / resolution -->
        <ProgressBar
            android:id="@+id/progress_preview_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Error display if file could not be retrieved -->
        <TextView
            android:id="@+id/text_preview_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Photo ImageView -->
        <ImageView
            android:id="@+id/img_preview_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Video Player VideoView -->
        <VideoView
            android:id="@+id/video_preview_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
