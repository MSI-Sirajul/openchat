<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_outgoing_audio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:keepScreenOn="true">

    <!-- Top Status Capsule -->
    <LinearLayout
        android:id="@+id/layout_top_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_video_pill_status"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Encrypted"
            android:src="@drawable/ic_lock_24"
            app:tint="#5DD69A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Outgoing Voice Call • Encrypted"
            android:textColor="#5DD69A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contact Avatar with Pulsing Ring -->
    <FrameLayout
        android:id="@+id/layout_avatar_container"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_capsule">

        <!-- Outer Pulsing Ring -->
        <View
            android:id="@+id/ring_pulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#203D52" />

        <ImageView
            android:id="@+id/img_contact_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:contentDescription="Contact Avatar"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/text_contact_initial"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#087EBA"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="50sp"
            android:textStyle="bold"
            tools:text="J" />
    </FrameLayout>

    <!-- Contact Name -->
    <TextView
        android:id="@+id/text_contact_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_avatar_container"
        tools:text="Jane Doe" />

    <!-- Outgoing Status -->
    <TextView
        android:id="@+id/text_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Calling..."
        android:textColor="#B0BEC5"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_contact_name" />

    <!-- Cancel Call Action -->
    <LinearLayout
        android:id="@+id/layout_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btn_cancel"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_video_call_end_circle"
            android:contentDescription="Cancel Voice Call"
            android:elevation="8dp"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_call_end_24"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancel"
            android:textColor="#FF8A80"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
