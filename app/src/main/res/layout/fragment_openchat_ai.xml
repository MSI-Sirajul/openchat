<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_openchat_ai_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- Special Top Header with OpenChat AI Identity & DeepSeek Model Toggle -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_openchat_ai"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/color_surface"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/color_primary_text"
        app:navigationContentDescription="@string/common_back"
        app:elevation="0dp"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:contentInsetEnd="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/color_ai_pill_bg">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sparkles_24"
                    android:contentDescription="@null"
                    app:tint="@color/color_ai_pill_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/openchat_ai_title"
                    android:textColor="@color/color_primary_text"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/text_openchat_ai_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/openchat_ai_subtitle_chat"
                    android:textColor="@color/color_secondary_text"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- DeepSeek Model Switcher Pill -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_openchat_ai_model_toggle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/openchat_ai_model_chat"
                android:textAllCaps="false"
                android:textColor="@color/color_ai_pill_text"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/color_ai_pill_bg"
                app:strokeColor="@color/color_ai_pill_border"
                app:strokeWidth="1dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_sparkles_24"
                app:iconTint="@color/color_ai_pill_text"
                app:iconSize="14dp"
                app:iconPadding="4dp" />

            <ImageButton
                android:id="@+id/btn_openchat_ai_reset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh_24"
                android:contentDescription="@string/openchat_ai_reset_cd"
                app:tint="@color/color_primary_text" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider" />

    <!-- Main Conversation & Hero Welcome Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_openchat_ai_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp"
            android:overScrollMode="ifContentScrolls" />

        <!-- Special Hero Welcome & Quick Prompt Cards -->
        <ScrollView
            android:id="@+id/layout_openchat_ai_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layout_openchat_ai_empty_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="20dp">

                <!-- Hero Greeting Card -->
                <LinearLayout
                    android:id="@+id/layout_openchat_ai_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_openchat_ai_hero_gradient"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="22dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:backgroundTint="@color/color_primary">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_sparkles_24"
                            android:contentDescription="@null"
                            app:tint="@color/color_on_primary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/openchat_ai_empty_heading"
                        android:textColor="@color/color_primary_text"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/text_openchat_ai_empty_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/openchat_ai_empty_body"
                        android:textColor="@color/color_secondary_text"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="2dp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Tactile Prompt Cards (2x2 Grid) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_suggest_draft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/color_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/color_ai_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="104dp"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_edit_24"
                                android:contentDescription="@null"
                                app:tint="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/openchat_ai_suggest_draft_title"
                                android:textColor="@color/color_primary_text"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/openchat_ai_suggest_draft_desc"
                                android:textColor="@color/color_secondary_text"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_suggest_translate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/color_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/color_ai_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="104dp"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chat_24"
                                android:contentDescription="@null"
                                app:tint="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/openchat_ai_suggest_translate_title"
                                android:textColor="@color/color_primary_text"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/openchat_ai_suggest_translate_desc"
                                android:textColor="@color/color_secondary_text"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_suggest_summarize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/color_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/color_ai_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="104dp"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_file_24"
                                android:contentDescription="@null"
                                app:tint="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/openchat_ai_suggest_summarize_title"
                                android:textColor="@color/color_primary_text"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/openchat_ai_suggest_summarize_desc"
                                android:textColor="@color/color_secondary_text"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_suggest_brainstorm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/color_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/color_ai_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="104dp"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_sparkles_24"
                                android:contentDescription="@null"
                                app:tint="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/openchat_ai_suggest_brainstorm_title"
                                android:textColor="@color/color_primary_text"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/openchat_ai_suggest_brainstorm_desc"
                                android:textColor="@color/color_secondary_text"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Error Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_openchat_ai_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color_error"
        app:cardBackgroundColor="@color/color_surface"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/text_openchat_ai_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_error"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_openchat_ai_retry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/openchat_ai_retry"
                android:textColor="@color/color_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Anchored Composer Dock (seamlessly matches surface & keyboard tracking) -->
    <LinearLayout
        android:id="@+id/layout_openchat_ai_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_openchat_ai_composer_shell"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp"
                android:paddingVertical="4dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_openchat_ai_prompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/openchat_ai_prompt_hint"
                    android:textColorHint="@color/color_composer_hint"
                    android:textColor="@color/color_composer_text"
                    android:textSize="15sp"
                    android:paddingVertical="10dp"
                    android:maxLines="5"
                    android:minHeight="48dp"
                    android:imeOptions="actionSend"
                    android:inputType="textMultiLine|textCapSentences" />

                <ImageButton
                    android:id="@+id/btn_openchat_ai_send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_primary"
                    android:src="@drawable/ic_send_24"
                    android:contentDescription="@string/openchat_ai_send_cd"
                    app:tint="@color/color_on_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
