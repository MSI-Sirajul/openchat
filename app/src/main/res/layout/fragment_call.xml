<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:padding="24dp">

    <!-- Top Security & Status Bar -->
    <LinearLayout
        android:id="@+id/layout_call_top_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_bubble_incoming"
        android:backgroundTint="#243442"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock_24"
            app:tint="#5DD69A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="End-to-End Encrypted"
            android:textColor="#5DD69A"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Caller Avatar with Pulse Ring -->
    <FrameLayout
        android:id="@+id/layout_caller_avatar_container"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/layout_call_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer Pulsing Ring -->
        <View
            android:id="@+id/ring_caller_pulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#203D52" />

        <TextView
            android:id="@+id/text_caller_avatar_initial"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#087EBA"
            android:gravity="center"
            android:text="U"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:fontFamily="sans-serif-bold" />
    </FrameLayout>

    <!-- Caller Name -->
    <TextView
        android:id="@+id/text_caller_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Contact Name"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/layout_caller_avatar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call Status / Timer -->
    <TextView
        android:id="@+id/text_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/call_calling_title"
        android:textColor="#A3B1BF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/text_caller_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Active Call Controls Container -->
    <LinearLayout
        android:id="@+id/layout_active_call_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mute Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_mute_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_mic_24"
            android:contentDescription="Mute Audio"
            app:tint="#FFFFFF"
            app:backgroundTint="#344452"
            app:elevation="4dp" />

        <!-- End Call Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_end_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_call_end_24"
            android:contentDescription="End Call"
            app:tint="#FFFFFF"
            app:backgroundTint="#D32F2F"
            app:fabCustomSize="64dp"
            app:elevation="6dp" />

        <!-- Speakerphone Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_toggle_speaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_volume_up_24"
            android:contentDescription="Toggle Speaker"
            app:tint="#FFFFFF"
            app:backgroundTint="#344452"
            app:elevation="4dp" />
    </LinearLayout>

    <!-- Incoming Call Controls Container -->
    <LinearLayout
        android:id="@+id/layout_incoming_call_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Decline Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_decline_incoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:src="@drawable/ic_call_end_24"
            android:contentDescription="Decline Call"
            app:tint="#FFFFFF"
            app:backgroundTint="#D32F2F"
            app:fabCustomSize="64dp"
            app:elevation="6dp" />

        <!-- Accept Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_accept_incoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:src="@drawable/ic_call_24"
            android:contentDescription="Accept Call"
            app:tint="#FFFFFF"
            app:backgroundTint="#16834A"
            app:fabCustomSize="64dp"
            app:elevation="6dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
