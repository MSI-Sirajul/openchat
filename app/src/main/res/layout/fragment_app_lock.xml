<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="24dp">

    <!-- Lock Icon -->
    <ImageView
        android:id="@+id/img_lock_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/ic_lock_24"
        android:contentDescription="Locked"
        app:tint="@color/color_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_lock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="OpenChat Locked"
        android:textColor="@color/color_primary_text"
        android:textSize="22sp"
        android:fontFamily="sans-serif-bold"
        app:layout_constraintTop_toBottomOf="@id/img_lock_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_lock_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Enter your 4-digit PIN"
        android:textColor="@color/color_secondary_text"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/text_lock_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4 PIN Dots Indicator -->
    <LinearLayout
        android:id="@+id/layout_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/text_lock_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/dot_pin_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/color_divider" />

        <View
            android:id="@+id/dot_pin_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/color_divider" />

        <View
            android:id="@+id/dot_pin_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/color_divider" />

        <View
            android:id="@+id/dot_pin_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/color_divider" />
    </LinearLayout>

    <!-- Error / Lockout Message -->
    <TextView
        android:id="@+id/text_lock_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/color_error"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_pin_dots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Numeric Keypad Grid (Table / GridLayout) -->
    <TableLayout
        android:id="@+id/table_keypad"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:stretchColumns="*"
        app:layout_constraintTop_toBottomOf="@id/text_lock_error"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow android:layout_marginBottom="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_1"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="1"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_2"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="2"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_3"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="3"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
        </TableRow>

        <TableRow android:layout_marginBottom="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_4"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="4"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_5"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="5"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_6"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="6"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
        </TableRow>

        <TableRow android:layout_marginBottom="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_7"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="7"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_8"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="8"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_9"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="9"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
        </TableRow>

        <TableRow>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_biometric"
                android:layout_width="68dp"
                android:layout_height="68dp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:icon="@drawable/ic_fingerprint_24"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:cornerRadius="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_0"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="0"
                android:textSize="22sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_backspace"
                android:layout_width="68dp"
                android:layout_height="68dp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:icon="@drawable/ic_backspace_24"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:cornerRadius="34dp" />
        </TableRow>
    </TableLayout>

    <!-- Forgot PIN / Reset Link -->
    <TextView
        android:id="@+id/btn_forgot_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Forgot PIN?"
        android:textColor="@color/color_primary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/table_keypad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
