<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Flat classic AOSP-style list row (No CardView, No Elevation) -->
    <LinearLayout
        android:id="@+id/layoutPermissionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/textPermissionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_primary_text"
                android:textSize="16sp"
                android:textStyle="normal"
                tools:text="Microphone" />

            <!-- Short Description -->
            <TextView
                android:id="@+id/textPermissionDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/color_secondary_text"
                android:textSize="13sp"
                tools:text="Record voice messages and speak during audio calls." />

        </LinearLayout>

        <!-- AOSP Style Flat Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            app:buttonTint="@color/color_primary" />

    </LinearLayout>

    <!-- Thin Divider -->
    <View
        android:id="@+id/dividerPermission"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:background="@color/color_divider" />

</LinearLayout>
